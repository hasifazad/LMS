{
  "name": "lms-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server exposing read-only LMS capabilities to AI agents",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "inspect:tools": "tsx scripts/list-tools.ts",
    "call": "tsx scripts/call-tool.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "axios": "^1.7.9",
    "dotenv": "^16.4.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5"
  }
}
