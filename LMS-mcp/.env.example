# ---------------------------------------------------------------------------
# LMS-mcp environment
# Copy to `.env` and adjust. Never commit a real `.env`.
# ---------------------------------------------------------------------------

# Runtime mode. `production` disables the development-only identity fallback.
NODE_ENV=development

# Origin of the LMS-server Express API (no trailing slash, no /api/v1).
# The server listens on its own PORT value from LMS-server/.env (3000 locally).
LMS_API_URL=http://localhost:3000

# Only change this if the backend is mounted somewhere other than /api/v1.
LMS_API_BASE_PATH=api/v1

# Sent as the `x-organization-id` header on every LMS request.
LMS_ORGANIZATION_ID=org1db

# Outbound request timeout in milliseconds.
LMS_API_TIMEOUT_MS=10000

# debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Authenticated user context
#
# "my ..." tools never accept a user id: the subject comes from this context.
# These variables are the DEVELOPMENT-ONLY fallback for local testing, because a
# stdio MCP process has no user session of its own. They are ignored unless
# LMS_MCP_ALLOW_ENV_USER_CONTEXT is true, which is the default in development and
# never the case when NODE_ENV=production.
#
# In production the host chatbot must supply the authenticated user through a
# UserContextResolver (see src/auth/user-context.ts).
# ---------------------------------------------------------------------------

# Set to false to refuse the environment fallback even in development.
LMS_MCP_ALLOW_ENV_USER_CONTEXT=true

# 24-character Mongo ObjectId of the authenticated user.
# For LMS_MCP_USER_ROLE=student this is a Student._id; for trainer/mentor it is a Trainer._id.
LMS_MCP_USER_ID=

# student | trainer | mentor | admin
LMS_MCP_USER_ROLE=student

# Email of the authenticated user. LMS-server identifies staff by email.
LMS_MCP_USER_EMAIL=

# Optional bearer token forwarded to the LMS API. Currently unused: LMS-server only
# enforces JWT on GET /api/v1/trainer/validate. Kept so that enabling upstream
# enforcement later needs no redesign.
LMS_MCP_SESSION_TOKEN=
